{
  "name": "dhaka-dash",
  "version": "2.0.0",
  "private": true,
  "description": "Satirical 3D street brawler: ordinary people versus corruption on a Dhaka avenue",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/game.js",
    "watch": "esbuild src/main.js --bundle --sourcemap --format=iife --target=es2020 --outfile=dist/game.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.187.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  }
}
